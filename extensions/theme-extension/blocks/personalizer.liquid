{%- comment -%}
  Dynamic Product Personalizer (Vite-bundled React Storefront Widget)
  Integrates with product metafield "app.customization_config"
{%- endcomment -%}

{%- assign config = product.metafields.app.customization_config.value -%}

{%- if config and config.enabled == true -%}
  {%- assign enabled = true -%}
  {%- assign is_demo = false -%}
{%- elsif request.design_mode -%}
  {%- comment -%} Theme Editor preview fallback {%- endcomment -%}
  {%- assign enabled = true -  %}
  {%- assign is_demo = true -%}
{%- else -%}
  {%- assign enabled = false -%}
{%- endif -%}

{%- if enabled -%}
  <!-- React Micro-frontend Mounting Node -->
  <div id="product-personalizer-root" 
       data-product-id="{{ product.id }}"
       data-base-image="{{ product.featured_image | image_url: width: 800 }}"
       data-shop-domain="{{ shop.permanent_domain }}"
       data-is-demo="{% if is_demo %}true{% else %}false{% endif %}"
       data-config='{{ product.metafields.app.customization_config.value | json }}'
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "Product Personalization",
  "target": "section",
  "stylesheet": "personalizer.css",
  "javascript": "product-personalizer.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personalize Your Item"
    }
  ]
}
{% endschema %}
