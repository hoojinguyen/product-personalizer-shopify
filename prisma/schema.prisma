// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Template {
  id        String   @id @default(uuid())
  name      String
  shop      String
  enabled   Boolean  @default(true)
  options   String   // JSON string of options and rules
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UpchargeMapping {
  id         String   @id @default(uuid())
  shop       String
  price      Float    // Price of this upcharge
  productId  String   // Shopify Product ID for the hidden upcharge product
  variantId  String   // Shopify Variant ID for the hidden upcharge variant
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OrderProcessingLog {
  id         String   @id @default(uuid())
  shop       String
  orderId    String
  status     String   // PENDING, COMPLETED, FAILED
  error      String?
  printFileUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Asset {
  id        String   @id @default(uuid())
  shop      String
  type      String   // FONT, COLOR, IMAGE, OPTION
  name      String   // e.g., "Vintage Script", "Leather Colors"
  value     String   // JSON string storing the actual values: URL for fonts/images, hex list for colors, array for options
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id              String   @id @default(uuid())
  shop            String   @unique
  layoutMode      String   @default("stacked") // stacked, tabs, modal
  brandColor      String   @default("#008060")
  buttonColor     String   @default("#008060")
  buttonTextColor String   @default("#ffffff")
  popupType       String   @default("partial") // partial, full
  showQuantity    Boolean  @default(true)
  cartRedirect    String   @default("stay")    // stay, cart, checkout
  exportFormat    String   @default("png")     // png, pdf
  dpiResolution   Int      @default(300)
  customCss       String?
  customJs        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


